<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ingram Users Page</title>
</head>

<body>
    <h1>This is the Profile of @<%=username %>
    </h1>
    <button>Follow</button>
    <button>Message</button>

    <h1>Accounts that follows me:</h1>
    <ul>
        <% for(let name of followers){ %>
            <li>
                <%= name%>
            </li>
            <%} %>
    </ul>

</body>

</html>